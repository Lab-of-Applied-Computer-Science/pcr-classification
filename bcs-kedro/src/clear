def map_to_6_classes(class_mapping, image_path):
    
    image = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
    for old_class, new_class in class_mapping.items():
        image[image == old_class] = new_class

    cv2.imwrite(image_path, image)

